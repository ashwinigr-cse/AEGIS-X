# AEGIS X Environment Configuration

# Server Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database Connection (Default SQLite for local lightweight development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./aegis_x.db
# DATABASE_URL=postgresql+asyncpg://aegis_user:aegis_password@localhost:5432/aegis_db

# LLM Provider Configuration (Groq / OpenAI compatible)
LLM_PROVIDER=groq
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# Hindsight Memory Engine
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=aegis-operational-memory

# Digital Twin & Fault Injection
TOXIPROXY_HOST=localhost
TOXIPROXY_PORT=8474
ISOLATED_ENV_NAMESPACE=aegis-twin

# Active Experiment Safety Parameters
MAX_EXPERIMENT_DURATION_SECONDS=30
MAX_LATENCY_INJECTION_MS=800
MAX_PACKET_DROP_RATE=0.20
RISK_AVERSION_LAMBDA=1.2
